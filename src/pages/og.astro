---
// Bron voor het deelbeeld /og-leja.png (1200 × 630). Niet geïndexeerd; wordt met een
// headless browser op 1200 × 630 vastgelegd en als public/og-leja.png in de repo gezet.
import '../styles/globals.css';
import logo from '../brand/logo/leja-van-bimforce-op-donker.svg?raw';
import Muur from '../components/Muur.astro';
---

<!doctype html>
<html lang="nl" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Deelbeeld Leja</title>
    <style>
      html, body { margin: 0; width: 1200px; height: 630px; overflow: hidden; }
    </style>
  </head>
  <body class="bg-brand text-on-brand">
    <div class="w-[1200px] h-[630px] grid grid-cols-12 items-center gap-10 px-16">
      <div class="col-span-7">
        <div class="[&>svg]:h-14 [&>svg]:w-auto" set:html={logo} />
        <h1 class="mt-10 text-[64px] leading-[1.05] font-bold text-on-brand">Huur het model,<br />bezit de kennis.</h1>
        <p class="mt-5 text-[30px] text-on-brand-2">Modellen wisselen. Het geheugen blijft.</p>
        <p class="mt-10 text-[22px] text-on-brand-2">leja.bimforce.com</p>
      </div>
      <div class="col-span-5">
        <div class="bg-surface rounded-card p-6"><Muur /></div>
      </div>
    </div>
  </body>
</html>
