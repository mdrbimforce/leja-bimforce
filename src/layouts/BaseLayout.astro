---
import '../styles/globals.css';
import logoOpDonker from '../brand/logo/leja-van-bimforce-op-donker.svg?raw';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description = 'Leja is een eigen bedrijfsgeheugen met vaste werkafspraken, waar elk AI-model op kan werken. Huur het model, bezit de kennis.',
  ogImage = '/og-leja.png',
  noIndex = false,
} = Astro.props;

const fullTitle = title === 'Leja' ? 'Leja — huur het model, bezit de kennis' : `${title} — Leja`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const nav = [
  { href: '/#muur', label: 'Waarom' },
  { href: '/#pijlers', label: 'Hoe het werkt' },
  { href: '/#cijfers', label: 'Cijfers' },
  { href: '/#contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1c2a41" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="bg-ground text-ink">
    <a href="#inhoud" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-nav focus:bg-surface focus:px-3 focus:py-2 focus:rounded-control">Naar de inhoud</a>

    <header class="op-brand bg-brand text-on-brand sticky top-0 z-nav">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-3 flex items-center justify-between gap-6">
        <a href="/" class="flex items-center no-underline text-on-brand" aria-label="Leja, van bimforce — naar de homepagina">
          <span class="block h-9 w-auto [&>svg]:h-9 [&>svg]:w-auto" set:html={logoOpDonker} />
        </a>
        <nav aria-label="Hoofdnavigatie">
          <ul class="flex gap-4 sm:gap-6 text-lj-14 font-semibold">
            {nav.map((n) => (
              <li><a href={n.href} class="text-on-brand-2 hover:text-on-brand no-underline transition-colors">{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <div class="h-0.5 bg-brand-line"></div>
    </header>

    <main id="inhoud">
      <slot />
    </main>

    <footer class="op-brand mt-24 bg-brand text-on-brand">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 flex flex-col sm:flex-row justify-between gap-6 items-start sm:items-center">
        <div class="text-lj-14 leading-snug">
          <div class="font-bold">Leja is een product van bimforce</div>
          <div class="text-on-brand-2">Boxtel · bimforce sinds 2016 · Leja in gebruik sinds februari 2026</div>
        </div>
        <ul class="flex flex-wrap gap-x-4 gap-y-1 text-lj-14">
          <li><a href="mailto:leja@bimforce.com" class="text-on-brand hover:text-on-brand-2">leja@bimforce.com</a></li>
          <li><a href="https://www.bimforce.com" class="text-on-brand hover:text-on-brand-2">bimforce.com</a></li>
          <li><a href="https://grids.bimforce.com" class="text-on-brand hover:text-on-brand-2">grids.bimforce.com</a></li>
          <li><a href="https://knowledge.bimforce.com" class="text-on-brand hover:text-on-brand-2">knowledge.bimforce.com</a></li>
          <li><a href="https://knowledge.bimforce.com/privacy" class="text-on-brand hover:text-on-brand-2">Privacy</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
