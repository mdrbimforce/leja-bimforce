{
  "$comment": "Bron van het Leja-stijlpakket. tokens.css wordt hieruit gegenereerd (node brand/scripts/build.mjs); tailwind-preset.cjs leest dit bestand direct. Waarden uit redesign-plan §5 (besluit Martijn 1-10-2026).",
  "version": "0.1.0",
  "prefix": "lj",
  "color": {
    "ground":      { "light": "#f3f5f7", "dark": "#0f1826", "rol": "Ondergrond", "gebruik": "achtergrond van de pagina" },
    "surface":     { "light": "#fdfdfd", "dark": "#172234", "rol": "Vlak", "gebruik": "kaarten, panelen, dialogen, invoervelden" },
    "sunken":      { "light": "#e7ecef", "dark": "#1f2d43", "rol": "Vlak, verdiept", "gebruik": "zoekveld, stille knop, kolom van een bord, codeblok" },
    "ink":         { "light": "#1c2a41", "dark": "#e7ecef", "rol": "Tekst", "gebruik": "lopende tekst en koppen" },
    "ink-2":       { "light": "#475365", "dark": "#abb8c6", "rol": "Tekst, tweede rang", "gebruik": "toelichting, waarden in een tabel" },
    "ink-3":       { "light": "#5f6977", "dark": "#8c99a8", "rol": "Tekst, gedempt", "gebruik": "bijschrift, label, tijdstip", "plan": { "light": "#6a7482", "dark": "#8593a3" }, "afwijking": "donkerder (licht) en lichter (donker) dan het plan, zodat de tekst ook op het verdiepte vlak 4,5 op 1 haalt; akkoord Martijn 1-10-2026" },
    "line":        { "light": "#d9dee4", "dark": "#2a3a52", "rol": "Lijn", "gebruik": "scheidingslijn, rand van een kaart" },
    "line-strong": { "light": "#788290", "dark": "#6a7c96", "rol": "Lijn, bediening", "gebruik": "rand van een invoerveld of selectievak (3 op 1 tegen het vlak)" },
    "brand":       { "light": "#1c2a41", "dark": "#0b1320", "rol": "Merk", "gebruik": "zijbalk, kop van de site" },
    "on-brand":    { "light": "#e7ecef", "dark": "#e7ecef", "rol": "Tekst op merk", "gebruik": "navigatie in de zijbalk" },
    "on-brand-2":  { "light": "#9fb0c3", "dark": "#8593a3", "rol": "Tekst op merk, gedempt", "gebruik": "groepslabel in de zijbalk" },
    "brand-line":  { "light": "#2e3f5a", "dark": "#1f2d43", "rol": "Lijn op merk", "gebruik": "actieve regel en scheiding in de zijbalk" },
    "accent":      { "light": "#0c6980", "dark": "#35b8c4", "rol": "Accent", "gebruik": "knoppen, links, actieve tab, focus" },
    "accent-hover":{ "light": "#0a5568", "dark": "#5ccbd5", "rol": "Accent, aanwijzen", "gebruik": "knop of link onder de muis" },
    "on-accent":   { "light": "#fdfdfd", "dark": "#0b1320", "rol": "Tekst op accent", "gebruik": "tekst op een knop" },
    "accent-soft": { "light": "#dff1f4", "dark": "#163a44", "rol": "Accent, zacht vlak", "gebruik": "gekozen regel, informatie-pil" },
    "spark":       { "light": "#e0a526", "dark": "#f0b840", "rol": "Kern", "gebruik": "markering, wacht op jou; als vulling, met donkere tekst erop" },
    "on-spark":    { "light": "#1c2a41", "dark": "#0b1320", "rol": "Tekst op kern", "gebruik": "teller, pil wacht op jou" },
    "spark-soft":  { "light": "#fbefd2", "dark": "#3a2f14", "rol": "Kern, zacht vlak", "gebruik": "achtergrond van een kaart die op je wacht" },
    "ok":          { "light": "#27724d", "dark": "#5cc28b", "rol": "Goed", "gebruik": "geslaagd, automatisch", "plan": { "light": "#2f855a" }, "afwijking": "donkerder dan het plan: #2f855a haalt 3,9 op zijn zachte vlak; akkoord Martijn 1-10-2026" },
    "ok-soft":     { "light": "#e1f2e8", "dark": "#173627", "rol": "Goed, zacht vlak", "gebruik": "achtergrond van een pil of melding" },
    "warn":        { "light": "#8a5a12", "dark": "#e6b450", "rol": "Let op", "gebruik": "waarschuwing, na goedkeuring" },
    "warn-soft":   { "light": "#fbf0d6", "dark": "#3a2f14", "rol": "Let op, zacht vlak", "gebruik": "achtergrond van een pil of melding" },
    "err":         { "light": "#c53030", "dark": "#f08080", "rol": "Fout", "gebruik": "foutmelding, verwijderen" },
    "err-soft":    { "light": "#fde8e8", "dark": "#40201f", "rol": "Fout, zacht vlak", "gebruik": "achtergrond van een pil of melding" },
    "never":       { "light": "#1c2a41", "dark": "#0b1320", "rol": "Nooit", "gebruik": "niveaupil nooit (donker, met slot)" },
    "on-never":    { "light": "#e7ecef", "dark": "#e7ecef", "rol": "Tekst op nooit", "gebruik": "tekst en slot in de niveaupil" },
    "scrim":       { "light": "rgb(12 22 38 / 0.45)", "dark": "rgb(4 8 14 / 0.6)", "rol": "Sluier", "gebruik": "achter een dialoog" }
  },
  "contrast": {
    "$comment": "Paren die check-contrast.mjs meet. min 4.5 voor tekst, 3 voor randen van bediening.",
    "text": [
      ["ink", "ground"], ["ink", "surface"], ["ink", "sunken"],
      ["ink-2", "ground"], ["ink-2", "surface"], ["ink-2", "sunken"],
      ["ink-3", "ground"], ["ink-3", "surface"], ["ink-3", "sunken"],
      ["accent", "ground"], ["accent", "surface"], ["accent", "sunken"], ["accent", "accent-soft"],
      ["accent-hover", "surface"],
      ["on-accent", "accent"], ["on-accent", "accent-hover"],
      ["on-brand", "brand"], ["on-brand-2", "brand"], ["on-brand", "brand-line"],
      ["on-spark", "spark"], ["ink", "spark-soft"], ["warn", "spark-soft"],
      ["ok", "ground"], ["ok", "surface"], ["ok", "ok-soft"],
      ["warn", "ground"], ["warn", "surface"], ["warn", "warn-soft"],
      ["err", "ground"], ["err", "surface"], ["err", "err-soft"],
      ["on-never", "never"]
    ],
    "ui": [
      ["line-strong", "surface"], ["line-strong", "ground"], ["line-strong", "sunken"],
      ["accent", "surface"], ["spark", "brand"]
    ]
  },
  "logo": {
    "$comment": "Vaste kleuren van het beeldmerk; die volgen het thema niet.",
    "navy": "#1c2a41",
    "teal": "#35b8c4",
    "teal-deep": "#0c6980",
    "amber": "#e0a526"
  },
  "font": {
    "sans": "'Source Sans 3', 'Myriad Pro', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "'Source Code Pro', Consolas, Monaco, monospace"
  },
  "weight": { "regular": 400, "semibold": 600, "bold": 700 },
  "text": {
    "$comment": "Schaal dashboard in px; tokens in rem (16 px basis). De website gebruikt dezelfde stappen met lopende tekst op 17 px.",
    "12": "0.75rem",
    "13": "0.8125rem",
    "14": "0.875rem",
    "16": "1rem",
    "20": "1.25rem",
    "24": "1.5rem",
    "32": "2rem",
    "site-body": "1.0625rem"
  },
  "leading": { "tight": 1.15, "snug": 1.3, "normal": 1.5 },
  "space": {
    "$comment": "Nummering volgt Tailwind: stap n is n × 4 px.",
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px"
  },
  "radius": { "control": "4px", "card": "8px", "pill": "999px" },
  "shadow": {
    "1": { "light": "0 1px 2px rgb(12 22 38 / 0.08), 0 1px 1px rgb(12 22 38 / 0.04)", "dark": "0 1px 2px rgb(0 0 0 / 0.4)" },
    "2": { "light": "0 8px 28px rgb(12 22 38 / 0.12), 0 2px 6px rgb(12 22 38 / 0.06)", "dark": "0 10px 32px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(42 58 82 / 0.6)" }
  },
  "layer": { "nav": 100, "panel": 200, "dialog": 300, "toast": 400 },
  "breakpoint": { "sm": "640px", "md": "960px", "lg": "1280px" },
  "motion": { "fast": "120ms", "base": "200ms", "ease": "cubic-bezier(0.2, 0, 0, 1)" }
}
