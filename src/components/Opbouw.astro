    <line x1="606" y1="225" x2="660" y2="225" stroke="var(--lj-spark)" stroke-width="3" />
    <text x="623" y="214" text-anchor="middle" class="t-klein t-zacht">poort</text>

    <!-- buiten de installatie -->
    <rect x="660" y="180" width="112" height="90" rx="8" fill="var(--lj-surface)" stroke="var(--lj-ink-3)" stroke-width="1.5" stroke-dasharray="4 4" />
    <text x="716" y="213" text-anchor="middle" class="t-kop t-kop-smal">Grote modellen</text>
    <text x="716" y="232" text-anchor="middle" class="t-klein">buiten, gehuurd,</text>
    <text x="716" y="248" text-anchor="middle" class="t-klein">via API</text>

    <rect x="660" y="330" width="112" height="84" rx="8" fill="var(--lj-surface)" stroke="var(--lj-ink-3)" stroke-width="1.5" stroke-dasharray="4 4" />
    <text x="716" y="361" text-anchor="middle" class="t-kop t-kop-smal">Sites</text>
    <text x="716" y="380" text-anchor="middle" class="t-klein">Astro op</text>
    <text x="716" y="396" text-anchor="middle" class="t-klein">Cloudflare Pages</text>
  </svg>

  <!-- smal -->
