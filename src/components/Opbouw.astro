---
// De opbouw van Leja op hoofdlijnen, voor /voor-techneuten. Vijf blokken: de knowledge graph als
// enige bron; het dashboard met een proxy; één gateway naar modellen; agents en koppelingen via MCP;
// routes met drie niveaus. Daaromheen tests en een tussenomgeving, en buiten de installatie de grote
// modellen en de sites. Bewust zonder schema, poorten, hostnames of versienummers.
// Kleuren zijn rollen uit het stijlpakket (zoals Muur.astro), zodat het beeld licht en donker volgt.
// Twee tekeningen: breed vanaf md (960 px), smal en staand daaronder.
---

<figure class="m-0">
  <!-- breed -->
  <svg viewBox="0 0 780 470" role="img" aria-labelledby="opbouw-breed-titel opbouw-breed-omschrijving" class="opbouw hidden md:block w-full h-auto">
    <title id="opbouw-breed-titel">De opbouw van Leja</title>
    <desc id="opbouw-breed-omschrijving">In het midden van de eigen installatie staat de knowledge graph op Neo4j, de enige bron. Daaraan verbonden: het dashboard met een proxy in Node, die elke actie langs rechten en spoor leidt; agents en koppelingen via MCP, zoals Claude Code, Claude Desktop en OpenCode; routes met drie niveaus, automatisch, na goedkeuring en nooit; en één gateway naar modellen, met een lokaal model op eigen hardware. Via die gateway, de poort, gaan aanroepen naar grote modellen buiten de installatie. Daaromheen tests in Playwright, een tussenomgeving en uitrol vanaf een geteste versie. Los daarvan de sites, op Astro en Cloudflare Pages.</desc>

    <!-- de installatie -->
    <rect x="16" y="16" width="624" height="436" rx="12" fill="none" stroke="var(--lj-line-strong)" stroke-width="1.5" stroke-dasharray="6 5" />
    <text x="32" y="40" class="t-label">Eigen installatie</text>
    <text x="32" y="438" class="t-klein t-zacht">Daaromheen: tests in Playwright, een tussenomgeving, uitrol vanaf een geteste versie</text>

    <!-- verbindingen met de graph -->
    <g stroke="var(--lj-ink-2)" stroke-width="2">
      <line x1="321" y1="120" x2="321" y2="150" />
      <line x1="222" y1="225" x2="246" y2="225" />
      <line x1="420" y1="225" x2="396" y2="225" />
      <line x1="321" y1="326" x2="321" y2="300" />
    </g>

    <!-- dashboard en proxy -->
    <rect x="196" y="34" width="250" height="86" rx="8" class="blok" />
    <text x="321" y="62" text-anchor="middle" class="t-kop">Dashboard</text>
    <text x="321" y="82" text-anchor="middle" class="t-tekst">met een proxy (Node) die elke actie</text>
    <text x="321" y="99" text-anchor="middle" class="t-tekst">langs rechten en spoor leidt</text>

    <!-- de knowledge graph -->
    <rect x="246" y="150" width="150" height="150" rx="10" fill="var(--lj-accent-soft)" stroke="var(--lj-accent)" stroke-width="2" />
    <g stroke="var(--lj-ink-2)" stroke-width="1.5" aria-hidden="true">
      <line x1="290" y1="192" x2="318" y2="174" />
      <line x1="318" y1="174" x2="350" y2="188" />
      <line x1="290" y1="192" x2="322" y2="202" />
      <line x1="350" y1="188" x2="322" y2="202" />
      <line x1="322" y1="202" x2="336" y2="226" />
      <line x1="290" y1="192" x2="300" y2="228" />
      <line x1="300" y1="228" x2="336" y2="226" />
    </g>
    <circle cx="290" cy="192" r="7" fill="var(--lj-accent)" />
    <circle cx="318" cy="174" r="6" fill="var(--lj-accent)" />
    <circle cx="350" cy="188" r="6" fill="var(--lj-accent)" />
    <circle cx="336" cy="226" r="7" fill="var(--lj-accent)" />
    <circle cx="300" cy="228" r="5" fill="var(--lj-accent)" />
    <circle cx="322" cy="202" r="6" fill="var(--lj-spark)" />
    <text x="321" y="264" text-anchor="middle" class="t-kop">Knowledge graph</text>
    <text x="321" y="282" text-anchor="middle" class="t-tekst">Neo4j, de enige bron</text>

    <!-- agents en koppelingen -->
    <rect x="36" y="165" width="186" height="120" rx="8" class="blok" />
    <text x="129" y="191" text-anchor="middle" class="t-kop">Agents en koppelingen</text>
    <text x="129" y="209" text-anchor="middle" class="t-tekst">via MCP</text>
    <text x="129" y="233" text-anchor="middle" class="t-klein">Claude Code, Claude Desktop,</text>
    <text x="129" y="249" text-anchor="middle" class="t-klein">OpenCode en andere clients</text>
    <text x="129" y="265" text-anchor="middle" class="t-klein">op hetzelfde geheugen</text>

    <!-- de gateway -->
    <rect x="420" y="165" width="186" height="120" rx="8" fill="var(--lj-sunken)" stroke="var(--lj-ink)" stroke-width="1.5" />
    <text x="513" y="191" text-anchor="middle" class="t-kop t-kop-smal">Eén gateway naar modellen</text>
    <text x="513" y="215" text-anchor="middle" class="t-klein">lokaal model op eigen hardware</text>
    <text x="513" y="233" text-anchor="middle" class="t-klein">voor wat binnen moet blijven;</text>
    <text x="513" y="251" text-anchor="middle" class="t-klein">grote modellen via API,</text>
    <text x="513" y="267" text-anchor="middle" class="t-klein">waar het beleid dat toestaat</text>

    <!-- routes -->
    <rect x="176" y="326" width="290" height="88" rx="8" class="blok" />
    <text x="321" y="350" text-anchor="middle" class="t-kop">Routes</text>
