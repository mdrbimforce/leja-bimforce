    <rect x="190" y="380" width="86" height="22" rx="11" fill="var(--lj-ok-soft)" />
    <text x="233" y="395" text-anchor="middle" class="t-pil" fill="var(--lj-ok)">automatisch</text>
    <rect x="284" y="380" width="106" height="22" rx="11" fill="var(--lj-spark-soft)" />
    <text x="337" y="395" text-anchor="middle" class="t-pil" fill="var(--lj-warn)">na goedkeuring</text>
    <rect x="398" y="380" width="54" height="22" rx="11" fill="var(--lj-never)" />
    <text x="425" y="395" text-anchor="middle" class="t-pil" fill="var(--lj-on-never)">nooit</text>

