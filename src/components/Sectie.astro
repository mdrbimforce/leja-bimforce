---
// Een sectie van twee kolommen: de kop links, de tekst rechts (zelfde opbouw als "Waarom een eigen
// geheugen" op de homepagina). Gebruikt op de lezerspagina's, Over en Contact.
export interface Props {
  kop: string;
  id?: string;
  /** Zet een lijn boven de sectie; standaard aan, behalve voor de eerste. */
  lijn?: boolean;
}
const { kop, id, lijn = true } = Astro.props;
---

<section id={id} class="mx-auto max-w-6xl px-4 sm:px-6 scroll-mt-20">
  <div class:list={['grid gap-4 md:gap-8 md:grid-cols-12 py-10 sm:py-12', lijn && 'border-t border-line']}>
    <div class="md:col-span-5">
      <h2 class="text-lj-24">{kop}</h2>
    </div>
    <div class="md:col-span-7 space-y-4 max-w-prose">
      <slot />
    </div>
  </div>
</section>
